{#- Week Aqua: prints your dashboard card with your own entity IDs.
    Developer tools -> Template: replace everything there with this file,
    then copy the result on the right into a new card (Add card -> Manual). -#}
{%- set p = (integration_entities('weekaqua') | select('match', 'light[.]') | first | default('light.none'))[6:] -%}
{% raw %}# Карточка Week Aqua для панели (русская версия)
# Панель → ⋮ → Изменить панель → Добавить карточку → Вручную, вставьте всё ниже.
# ID объектов начинаются с имени светильника; если у вас не
# "{% endraw %}{{ p }}{% raw %}", замените этот текст везде (и в строке шаблона
# "{% set p = ... %}").
type: vertical-stack
cards:
  - type: tile
    entity: light.{% endraw %}{{ p }}{% raw %}
    name: Аквариум
    icon: mdi:fishbowl-outline
    state_content:
      - state
      - brightness
      - effect
    features:
      - type: light-brightness

  - type: tile
    entity: select.{% endraw %}{{ p }}{% raw %}_preset
    name: Пресет
    features:
      - type: select-options

  - type: grid
    columns: 3
    square: false
    cards:
      - type: tile
        entity: switch.{% endraw %}{{ p }}{% raw %}_schedule
        name: Расписание
        vertical: true
        tap_action:
          action: toggle
      - type: tile
        entity: switch.{% endraw %}{{ p }}{% raw %}_maintenance_mode
        name: Обслуживание
        vertical: true
        tap_action:
          action: toggle
      - type: tile
        entity: switch.{% endraw %}{{ p }}{% raw %}_photo_mode
        name: Фото
        vertical: true
        tap_action:
          action: toggle
      - type: tile
        entity: switch.{% endraw %}{{ p }}{% raw %}_acclimation
        name: Акклиматизация
        vertical: true
        tap_action:
          action: toggle
      - type: tile
        entity: button.{% endraw %}{{ p }}{% raw %}_back_to_schedule
        name: К расписанию
        icon: mdi:calendar-sync
        vertical: true
        tap_action:
          action: perform-action
          perform_action: button.press
          target:
            entity_id: button.{% endraw %}{{ p }}{% raw %}_back_to_schedule
      - type: tile
        entity: button.{% endraw %}{{ p }}{% raw %}_re_send_current_state
        name: Повторить
        icon: mdi:sync
        vertical: true
        tap_action:
          action: perform-action
          perform_action: button.press
          target:
            entity_id: button.{% endraw %}{{ p }}{% raw %}_re_send_current_state

  - type: markdown
    title: Сегодня
    content: |
      {%- set p = (integration_entities('weekaqua') | select('match', 'light[.]') | first | default('light.none'))[6:] -%}
      {%- set conn = states('binary_sensor.' ~ p ~ '_connection') -%}
      {%- set co2 = states('binary_sensor.' ~ p ~ '_co2_ready') -%}
      {%- set mode_m = is_state('switch.' ~ p ~ '_maintenance_mode', 'on') -%}
      {%- set mode_p = is_state('switch.' ~ p ~ '_photo_mode', 'on') -%}
      {%- if conn == 'off' %}
      <ha-alert alert-type="error">Светильник недоступен: {{ state_attr('binary_sensor.' ~ p ~ '_connection', 'last_error') }}</ha-alert>
      {% endif -%}
      {%- if co2 == 'off' and states('sensor.' ~ p ~ '_power') | float(0) > 0 %}
      <ha-alert alert-type="warning">CO₂ не готов ({{ state_attr('binary_sensor.' ~ p ~ '_co2_ready', 'reason') }}), поэтому свет работает с пониженной яркостью.</ha-alert>
      {% endif -%}
      {%- if mode_m or mode_p -%}
      {%- set sw = 'switch.' ~ p ~ ('_maintenance_mode' if mode_m else '_photo_mode') %}
      <ha-alert alert-type="info">Режим {{ 'обслуживания' if mode_m else 'фото' }} до {{ as_timestamp(state_attr(sw, 'ends_at')) | timestamp_custom('%H:%M') }}, затем возврат к расписанию.</ha-alert>
      {% endif %}
      **Сейчас:** {{ states('sensor.' ~ p ~ '_current_step') }}
      {%- if state_attr('sensor.' ~ p ~ '_fade', 'active') %}

      **Переход:** {{ states('sensor.' ~ p ~ '_fade') }} ({{ state_attr('sensor.' ~ p ~ '_fade', 'progress') }})
      {%- endif %}

      **Каналы** ({{ state_attr('sensor.' ~ p ~ '_step_channels', 'applies') or '–' }}): {{ states('sensor.' ~ p ~ '_step_channels') }} · мощность {{ state_attr('sensor.' ~ p ~ '_step_channels', 'power') or '–' }}

      {% set nxt = states('sensor.' ~ p ~ '_next_step') -%}
      {%- if nxt not in ['unknown', 'unavailable', 'none'] -%}
      **Далее в {{ as_timestamp(nxt) | timestamp_custom('%H:%M') }}:** {{ state_attr('sensor.' ~ p ~ '_next_step', 'step') }}{% if state_attr('sensor.' ~ p ~ '_next_step', 'also') %} · также {{ state_attr('sensor.' ~ p ~ '_next_step', 'also') }}{% endif %}
      {%- else -%}
      **Далее:** расписание выключено
      {%- endif %}

      **День:** {{ states('sensor.' ~ p ~ '_all_steps') }}

      **Свет:** {{ states('sensor.' ~ p ~ '_light_today') | float(0) | round(1) }} из {{ states('sensor.' ~ p ~ '_light_plan') | float(0) | round(1) }} ч полной мощности сегодня (по плану к этому времени {{ state_attr('sensor.' ~ p ~ '_light_today', 'planned_until_now') | float(0) | round(1) }}), свет {{ state_attr('sensor.' ~ p ~ '_light_plan', 'light_from') }}–{{ state_attr('sensor.' ~ p ~ '_light_plan', 'light_until') }}
      {%- if not is_state('sensor.' ~ p ~ '_co2_schedule', 'unavailable') %}

      **CO₂:** {{ states('sensor.' ~ p ~ '_co2_schedule') }}
      {%- endif %}
      {%- set acc = states('sensor.' ~ p ~ '_acclimation') -%}
      {%- set nc = state_attr('sensor.' ~ p ~ '_acclimation', 'next_change') -%}
      {%- set btn = state_attr('sensor.' ~ p ~ '_acclimation', 'back_to_normal') -%}
      {%- if acc not in ['Not running', 'unknown', 'unavailable'] %}

      **Акклиматизация:** {{ acc }}{% if nc %} · следующий шаг {{ strptime(nc, '%Y-%m-%d').strftime('%d.%m') }}{% endif %}{% if btn %} · обычное с {{ strptime(btn, '%Y-%m-%d').strftime('%d.%m') }}{% endif %}
      {%- endif %}

  - type: horizontal-stack
    cards:
      - type: gauge
        entity: sensor.{% endraw %}{{ p }}{% raw %}_power
        name: Мощность
        min: 0
        max: 100
        severity:
          green: 0
          yellow: 90
          red: 100
      - type: history-graph
        title: Свет за сегодня
        hours_to_show: 24
        entities:
          - entity: sensor.{% endraw %}{{ p }}{% raw %}_power
            name: Мощность

  - type: entities
    title: Каналы
    show_header_toggle: false
    entities:
      - entity: number.{% endraw %}{{ p }}{% raw %}_1_r
        name: Красный
      - entity: number.{% endraw %}{{ p }}{% raw %}_2_g
        name: Зелёный
      - entity: number.{% endraw %}{{ p }}{% raw %}_3_b
        name: Синий
      - entity: number.{% endraw %}{{ p }}{% raw %}_4_uv
        name: UV
      - entity: number.{% endraw %}{{ p }}{% raw %}_5_fan
        name: Вентилятор

  - type: markdown
    content: |
      {%- set dev = device_id(integration_entities('weekaqua') | select('match', 'light[.]') | first | default('')) -%}
      <ha-icon icon="mdi:cog"></ha-icon> [Настройки (Настроить)](/config/integrations/integration/weekaqua) &nbsp;·&nbsp; <ha-icon icon="mdi:fishbowl-outline"></ha-icon> [Страница устройства](/config/devices/device/{{ dev }})
{% endraw %}